# GEMINI_API_KEY is required for recipe generation
GEMINI_API_KEY=

# Stripe API Keys
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend API Key and Custom Sender Email for email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Production CORS allow-list (comma-separated list of allowed origins)
# Example: https://dinnerbydesign.app,https://www.dinnerbydesign.app
# Leave empty in development — all origins are allowed when NODE_ENV != production
ALLOWED_ORIGINS=

# Vercel cron authentication for the production search canary
CRON_SECRET=

# Anonymous guest-search abuse protection. Use a random server-only value.
GUEST_RATE_LIMIT_SECRET=

# Firebase App Check starts in monitoring mode. Set the site key after registering
# a reCAPTCHA Enterprise provider, then enable API enforcement after checking metrics.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
FIREBASE_APP_CHECK_ENFORCE_API=false

# Optional Playwright signed-in checks
# Use dedicated QA accounts only. Do not use a personal account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_RUN_LIVE_JOURNEY=false
