{
  "name": "dinner-by-design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.cts",
    "build": "vite build && tsx scripts/generateSeoPages.ts && esbuild server.cts --bundle --platform=node --format=cjs --outfile=api/server.js",
    "start": "node api/server.js",
    "preview": "vite preview",
    "build:native": "VITE_API_BASE_URL=https://dinnerbydesign.app VITE_NATIVE_TEST_BUILD=true vite build",
    "build:native:release": "VITE_API_BASE_URL=https://dinnerbydesign.app VITE_NATIVE_TEST_BUILD=false vite build",
    "native:sync:ios": "npm run build:native && npx cap sync ios",
    "native:open:ios": "npx cap open ios",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "smoke:public": "tsx scripts/smokePublicPages.ts",
    "check:publisher": "tsx scripts/checkPublisherCandidate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@stripe/stripe-js": "^4.1.0",
    "@vercel/functions": "^3.9.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.42.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^0.546.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "stripe": "^17.x",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "@grpc/grpc-js": "1.14.5",
    "browserslist": "4.28.8",
    "nanoid": "3.3.18",
    "qs": "6.16.0",
    "tar": "7.5.22",
    "undici": "7.29.1",
    "brace-expansion": "2.1.7",
    "uuid": "11.1.1"
  }
}
