{
  "name": "dinner-by-design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/generateSeoPages.ts && esbuild server.ts --bundle --platform=node --format=cjs --outfile=api/server.js",
    "start": "node api/server.js",
    "preview": "vite preview",
    "build:native": "VITE_API_BASE_URL=https://dinnerbydesign.app VITE_NATIVE_TEST_BUILD=true vite build",
    "build:native:release": "VITE_API_BASE_URL=https://dinnerbydesign.app VITE_NATIVE_TEST_BUILD=false vite build",
    "native:sync:ios": "npm run build:native && npx cap sync ios",
    "native:open:ios": "npx cap open ios",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "smoke:public": "tsx scripts/smokePublicPages.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@stripe/stripe-js": "^9.13.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.21.0",
    "stripe": "^22.x",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@capacitor/browser": "^6.0.6",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
