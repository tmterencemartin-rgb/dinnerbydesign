{
  "version": 2,
  "redirects": [
    {
      "source": "/food-costs/cooking-for-four-with-lower-cost-cuts",
      "destination": "/food-costs/cooking-with-cheaper-cuts-of-meat",
      "permanent": true
    },
    {
      "source": "/food-costs/low-cost-cooking-techniques",
      "destination": "/food-costs/ways-to-reduce-grocery-costs",
      "permanent": true
    },
    {
      "source": "/food-costs/how-to-use-complete-packs",
      "destination": "/food-costs/five-dinners-same-ingredients",
      "permanent": true
    },
    {
      "source": "/food-costs/cheap-finishing-touches",
      "destination": "/food-costs/make-low-cost-dinners-more-interesting",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dinnerbydesignv2.vercel.app"
        }
      ],
      "destination": "https://dinnerbydesign.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dinner-by-designv2.vercel.app"
        }
      ],
      "destination": "https://dinnerbydesign.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dinner-by-design2.vercel.app"
        }
      ],
      "destination": "https://dinnerbydesign.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/api/missing-asset"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/googleadd2ba831c07f99d.html",
      "destination": "/googleadd2ba831c07f99d.html"
    },
    {
      "source": "/dinner-plans/5-dinners-for-2-under-40",
      "destination": "/dinner-plans/5-dinners-for-2-under-40/index.html"
    },
    {
      "source": "/dinner-plans/5-affordable-family-dinners-for-four",
      "destination": "/dinner-plans/5-affordable-family-dinners-for-four/index.html"
    },
    {
      "source": "/food-costs/uk-food-costs-2026",
      "destination": "/food-costs/uk-food-costs-2026/index.html"
    },
    {
      "source": "/guides/do-vegetables-in-dishes-count-towards-5-a-day",
      "destination": "/guides/do-vegetables-in-dishes-count-towards-5-a-day/index.html"
    },
    {
      "source": "/dinner-plans/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/food-costs/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/guides/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/why-dinnerbydesign",
      "destination": "/why-dinnerbydesign/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/pricing-methodology",
      "destination": "/pricing-methodology/index.html"
    },
    {
      "source": "/recipe-methodology",
      "destination": "/recipe-methodology/index.html"
    },
    {
      "source": "/nutrition-methodology",
      "destination": "/nutrition-methodology/index.html"
    },
    {
      "source": "/food-safety",
      "destination": "/food-safety/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/ingredient-prices/refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/monitor/search-canary",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/health/deep",
      "schedule": "30 5 * * *"
    }
  ]
}
